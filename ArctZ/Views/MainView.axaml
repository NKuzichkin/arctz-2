<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ArctZ.ViewModels"
             xmlns:js="using:ArctZ.Components.VirtualJoystick"
             xmlns:program="using:ArctZ.Services.Program"
             xmlns:diagnostics="using:ArctZ.Services.Diagnostics"
             xmlns:sys="using:System"
             xmlns:conv="using:ArctZ.Converters"
             xmlns:materialIcons="using:Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="ArctZ.Views.MainView"
             x:DataType="vm:ProgramViewModel"
             Background="{StaticResource HudBackgroundBrush}"
             Foreground="{StaticResource HudTextPrimaryBrush}">

    <UserControl.Resources>
        <conv:ConnectionStateToBrushConverter x:Key="StateToBrush" />
        <conv:LabelLengthToFontSizeConverter x:Key="LabelLengthToFontSize" />
        <conv:KeyPointIsExecutingConverter x:Key="KeyPointIsExecuting" />
        <conv:EnumEqualsConverter x:Key="EnumEquals" />
        <js:RadiusToSizeConverter x:Key="RadiusToSize" />
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Border.reveal-1, Border.reveal-2, Border.reveal-3">
            <Style.Animations>
                <Animation Duration="0:0:0.4" Easing="CubicEaseOut" FillMode="Forward">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Border.reveal-2">
            <Style.Animations>
                <Animation Duration="0:0:0.4" Delay="0:0:0.08" Easing="CubicEaseOut" FillMode="Forward">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Border.reveal-3">
            <Style.Animations>
                <Animation Duration="0:0:0.4" Delay="0:0:0.16" Easing="CubicEaseOut" FillMode="Forward">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Foreground/Background/BorderBrush below use DynamicResource, not StaticResource,
             for consistency with ArctZ/Themes/HudControls.axaml and VirtualJoystick.axaml's
             Hud*-referencing Setters, and as a hardening measure: Setter values in ANY
             Styles collection resolve once when that collection is populated, so a
             StaticResource Setter here is only safe as long as MainView keeps being built
             after App.axaml.cs applies the print-theme palette (true today, since MainView
             is only ever constructed from OnFrameworkInitializationCompleted). Direct
             element attributes elsewhere in this file (e.g. this UserControl's own
             Background/Foreground above) resolve correctly with StaticResource for the
             same reason, and don't need to change. -->
        <Style Selector="TextBlock.section-heading">
            <Setter Property="FontFamily" Value="{StaticResource HudFontBody}" />
            <Setter Property="FontSize" Value="{StaticResource HudFontSizeSmall}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource HudTextSecondaryBrush}" />
            <Setter Property="LetterSpacing" Value="1.5" />
        </Style>

        <Style Selector="Border.loaded-entry">
            <Setter Property="Background" Value="{DynamicResource HudAccentDimBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HudAccentBrush}" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
        </Style>

        <Style Selector="Border.executing-indicator">
            <Setter Property="Background" Value="{DynamicResource HudAccentOverlayBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HudAccentBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>

    </UserControl.Styles>

    <Grid>
        <DockPanel IsEnabled="{Binding !Connection.IsAnyModalVisible}">
            <Border x:Name="HeaderBorder" DockPanel.Dock="Top" Classes="reveal-1"
                    Background="{StaticResource HudPanelBrush}"
                    BorderBrush="{StaticResource HudBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="12,10">
                <StackPanel x:Name="HeaderPanel" Spacing="8">
                    <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                        <Button Grid.Column="0" Classes="icon-action" Command="{Binding ToggleSideMenuCommand}" Margin="0,0,8,0">
                            <materialIcons:MaterialIcon Kind="Menu" />
                        </Button>
                        <Border x:Name="HeaderStatusRow" Grid.Column="1" Background="{StaticResource HudPanelElevatedBrush}" BorderBrush="{StaticResource HudBorderStrongBrush}"
                                BorderThickness="1" Padding="10,6">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" VerticalAlignment="Center">
                                <ContentControl x:Name="ConnectionStatus" Grid.Column="0" ClipToBounds="True" Content="{Binding Connection}" />
                                <Border Grid.Column="1" Classes="header-divider" />
                                <TextBlock Grid.Column="2" Classes="telemetry" FontSize="14" VerticalAlignment="Center" Text="{Binding StatusLabel}" />
                                <Border Grid.Column="3" Classes="header-divider" />
                                <Button Grid.Column="4" Classes="icon-action" Command="{Binding Connection.DisconnectCommand}" ToolTip.Tip="Отключить">
                                    <materialIcons:MaterialIcon Kind="PowerPlugOff" />
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                    <ScrollViewer x:Name="HeaderActionsScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  IsEnabled="{Binding !IsSideMenuOpen}">
                        <StackPanel x:Name="HeaderActions" Orientation="Horizontal" Spacing="8">
                            <Button Classes="primary header-action" Command="{Binding PlayCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <materialIcons:MaterialIcon Kind="Play" Width="16" Height="16" VerticalAlignment="Center" />
                                    <TextBlock Text="Пуск" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Classes="header-action" Command="{Binding PauseCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <materialIcons:MaterialIcon Kind="Pause" Width="16" Height="16" VerticalAlignment="Center" />
                                    <TextBlock Text="Пауза" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Classes="danger header-action" Command="{Binding StopCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <materialIcons:MaterialIcon Kind="Stop" Width="16" Height="16" VerticalAlignment="Center" />
                                    <TextBlock Text="Стоп" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- A single Grid is the DockPanel's true last child so it receives the fill slot;
                 the program panel and its overlays sit stacked inside it, toggled by IsVisible. -->
            <Grid x:Name="RootPanel">
                <!-- radius formula in MainView.axaml.cs (ComputeJoystickRadius) depends on these margins —
                     see ContentGridChromeWidth/ContentBorderVerticalChrome/ContentGridVerticalMargin/JoystickBarTopMargin -->
                <Border Classes="reveal-3" Margin="12"
                        Background="{StaticResource HudPanelBrush}"
                        BorderBrush="{StaticResource HudBorderBrush}"
                        BorderThickness="1">
                    <Grid x:Name="ContentGrid" RowDefinitions="*,Auto" Margin="20">
                        <ScrollViewer x:Name="ProgramPanel" Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="10">
                            <StackPanel Spacing="10" IsEnabled="{Binding !IsProgramLocked}">
                                <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                                    <Button Grid.Column="0" Classes="icon-action" Command="{Binding CaptureKeyPointCommand}"
                                            ToolTip.Tip="Захватить" Margin="0,0,8,0">
                                        <materialIcons:MaterialIcon Kind="Target" />
                                    </Button>
                                    <TextBlock Grid.Column="1" Classes="section-heading" Text="ПРОГРАММА" VerticalAlignment="Center" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Classes="telemetry" FontSize="16" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Text="{Binding ProgramName}" />
                                    <Button Grid.Column="1" Padding="8,2" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Kind="DotsVertical" />
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuItem Header="Переименовать" Command="{Binding RenameProgramCommand}">
                                                    <MenuItem.Icon>
                                                        <materialIcons:MaterialIcon Kind="Pencil" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="Новая" Command="{Binding NewProgramCommand}">
                                                    <MenuItem.Icon>
                                                        <materialIcons:MaterialIcon Kind="FileDocumentPlusOutline" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="Сохранить" Command="{Binding SaveProgramCommand}">
                                                    <MenuItem.Icon>
                                                        <materialIcons:MaterialIcon Kind="ContentSave" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="Настройки завершения" Command="{Binding EditCompletionSettingsCommand}">
                                                    <MenuItem.Icon>
                                                        <materialIcons:MaterialIcon Kind="FlagCheckered" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="Библиотека" Command="{Binding OpenLibraryCommand}">
                                                    <MenuItem.Icon>
                                                        <materialIcons:MaterialIcon Kind="Bookshelf" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                                <TextBlock Classes="section-heading" Text="ТОЧКИ" Margin="0,8,0,0" />
                                <ProgressBar Value="{Binding PhysicalOverallProgress}" Minimum="0" Maximum="1"
                                             Height="4" Margin="0,4,0,0"
                                             Foreground="{DynamicResource HudAccentBrush}"
                                             Background="{DynamicResource HudPanelElevatedBrush}"
                                             IsVisible="{Binding IsProgramLocked}">
                                    <ProgressBar.Transitions>
                                        <Transitions>
                                            <DoubleTransition Property="Value" Duration="0:0:0.3" Easing="CubicEaseOut" />
                                        </Transitions>
                                    </ProgressBar.Transitions>
                                </ProgressBar>
                                <ItemsControl x:Name="KeyPointsList" ItemsSource="{Binding KeyPoints}"
                                              ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel ItemSpacing="8" LineSpacing="8" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="program:KeyPoint">
                                            <Panel>
                                                <Button Width="120" Height="60"
                                                        Background="{StaticResource HudPanelElevatedBrush}"
                                                        BorderBrush="{StaticResource HudBorderBrush}" BorderThickness="1"
                                                        Padding="16,14" HorizontalContentAlignment="Left">
                                                    <Button.Flyout>
                                                        <MenuFlyout>
                                                            <MenuItem Header="На точку" CommandParameter="{Binding}"
                                                                      Command="{Binding ((vm:ProgramViewModel)DataContext).MoveMachineToKeyPointCommand, ElementName=KeyPointsList}">
                                                                <MenuItem.Icon>
                                                                    <materialIcons:MaterialIcon Kind="Crosshairs" />
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="Изменить" CommandParameter="{Binding}"
                                                                      Command="{Binding ((vm:ProgramViewModel)DataContext).EditKeyPointCommand, ElementName=KeyPointsList}">
                                                                <MenuItem.Icon>
                                                                    <materialIcons:MaterialIcon Kind="Pencil" />
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="Из машины" CommandParameter="{Binding}"
                                                                      Command="{Binding ((vm:ProgramViewModel)DataContext).FillKeyPointFromCurrentPositionCommand, ElementName=KeyPointsList}">
                                                                <MenuItem.Icon>
                                                                    <materialIcons:MaterialIcon Kind="Import" />
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="Переместить вверх" CommandParameter="{Binding}"
                                                                      Command="{Binding ((vm:ProgramViewModel)DataContext).MoveKeyPointUpCommand, ElementName=KeyPointsList}">
                                                                <MenuItem.Icon>
                                                                    <materialIcons:MaterialIcon Kind="ArrowUp" />
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="Переместить вниз" CommandParameter="{Binding}"
                                                                      Command="{Binding ((vm:ProgramViewModel)DataContext).MoveKeyPointDownCommand, ElementName=KeyPointsList}">
                                                                <MenuItem.Icon>
                                                                    <materialIcons:MaterialIcon Kind="ArrowDown" />
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="Удалить" CommandParameter="{Binding}"
                                                                      Command="{Binding ((vm:ProgramViewModel)DataContext).RemoveKeyPointCommand, ElementName=KeyPointsList}">
                                                                <MenuItem.Icon>
                                                                    <materialIcons:MaterialIcon Kind="TrashCanOutline" />
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                        </MenuFlyout>
                                                    </Button.Flyout>
                                                    <TextBlock Classes="telemetry" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                                               FontSize="{Binding Label, Converter={StaticResource LabelLengthToFontSize}}"
                                                               Text="{Binding Label}" />
                                                </Button>
                                                <Border Classes="executing-indicator" IsHitTestVisible="False">
                                                    <Border.IsVisible>
                                                        <MultiBinding Converter="{StaticResource KeyPointIsExecuting}">
                                                            <Binding Path="Id" />
                                                            <Binding Path="((vm:ProgramViewModel)DataContext).CurrentlyExecutingKeyPointId" ElementName="KeyPointsList" />
                                                        </MultiBinding>
                                                    </Border.IsVisible>
                                                </Border>
                                            </Panel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <Border IsVisible="{Binding FaultedAtSegmentIndex, Converter={x:Static ObjectConverters.IsNotNull}}"
                                    Background="{StaticResource HudWarningDimBrush}" BorderBrush="{StaticResource HudWarningBrush}"
                                    BorderThickness="1" Padding="12,8" Margin="0,12,0,0">
                                <TextBlock Foreground="{StaticResource HudWarningBrush}" TextWrapping="Wrap"
                                           Text="{Binding FaultedMessage}" />
                            </Border>
                        </StackPanel>
                        </ScrollViewer>

                        <Grid x:Name="JoystickBar" Grid.Row="1" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" Margin="0,12,0,0">
                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <js:VirtualJoystick x:Name="LeftJoystick" Mode="Fixed" Shape="Circle"
                                                     IsEnabled="{Binding !IsProgramLocked}"
                                                     JoystickDown="OnLeftJoystickDown" JoystickMove="OnLeftJoystickMove" JoystickUp="OnLeftJoystickUp" />
                                <TextBlock Text="Подъём / поворот стрелы" Opacity="0.6" FontSize="12"
                                           TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"
                                           MaxWidth="{Binding Radius, ElementName=LeftJoystick, Converter={StaticResource RadiusToSize}}" />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4" Width="160"
                                        HorizontalAlignment="Center" VerticalAlignment="Center"
                                        IsVisible="{Binding !IsNarrowJoystickLayout}">
                                <Slider Minimum="5" Maximum="100" Value="{Binding JoystickSpeedPercent}" />
                                <TextBlock Text="{Binding JoystickSpeedPercent, StringFormat='{}{0:0}%'}" Opacity="0.6" FontSize="12"
                                           HorizontalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <js:VirtualJoystick x:Name="RightJoystick" Mode="Fixed" Shape="Circle"
                                                     IsEnabled="{Binding !IsProgramLocked}"
                                                     JoystickDown="OnRightJoystickDown" JoystickMove="OnRightJoystickMove" JoystickUp="OnRightJoystickUp" />
                                <TextBlock Text="Пан / наклон камеры" Opacity="0.6" FontSize="12"
                                           TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"
                                           MaxWidth="{Binding Radius, ElementName=RightJoystick, Converter={StaticResource RadiusToSize}}" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Spacing="4" Margin="0,8,0,0"
                                        IsVisible="{Binding IsNarrowJoystickLayout}">
                                <Slider Minimum="5" Maximum="100" Value="{Binding JoystickSpeedPercent}" HorizontalAlignment="Stretch" />
                                <TextBlock Text="{Binding JoystickSpeedPercent, StringFormat='{}{0:0}%'}" Opacity="0.6" FontSize="12"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border IsVisible="{Binding IsEditingKeyPoint}" Background="{StaticResource HudScrimBrush}">
                    <Border x:DataType="vm:KeyPointEditorViewModel" DataContext="{Binding KeyPointEditor}"
                            Width="320" Background="{StaticResource HudPanelElevatedBrush}"
                            BorderBrush="{StaticResource HudBorderStrongBrush}" BorderThickness="1"
                            Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Spacing="10">
                            <TextBlock Classes="section-heading" Text="{Binding Number, StringFormat='ТОЧКА №{0}'}" />
                            <TextBox Text="{Binding Label}" PlaceholderText="Название" MaxLength="30" />
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" Margin="0,4,0,0">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="X" VerticalAlignment="Center" Margin="0,0,10,6" />
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding X}" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Y" VerticalAlignment="Center" Margin="0,0,10,6" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Y}" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Z" VerticalAlignment="Center" Margin="0,0,10,6" />
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Z}" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="A" VerticalAlignment="Center" Margin="0,0,10,6" />
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding A}" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Время перехода, с" VerticalAlignment="Center" Margin="0,0,10,6" />
                                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding TransitionSeconds}" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Стоянка, с" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding DwellSeconds}" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
                                <Button Command="{Binding CancelCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <materialIcons:MaterialIcon Kind="Close" Width="16" Height="16" VerticalAlignment="Center" />
                                        <TextBlock Text="Отмена" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="primary" Command="{Binding SaveCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <materialIcons:MaterialIcon Kind="ContentSave" Width="16" Height="16" VerticalAlignment="Center" />
                                        <TextBlock Text="Сохранить" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Border>

                <Border IsVisible="{Binding IsEditingCompletionSettings}" Background="{StaticResource HudScrimBrush}">
                    <Border x:DataType="vm:CompletionSettingsViewModel" DataContext="{Binding CompletionSettingsEditor}"
                            Width="320" Background="{StaticResource HudPanelElevatedBrush}"
                            BorderBrush="{StaticResource HudBorderStrongBrush}" BorderThickness="1"
                            Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Spacing="10">
                            <TextBlock Classes="section-heading" Text="НАСТРОЙКИ ЗАВЕРШЕНИЯ" />
                            <RadioButton GroupName="CompletionMode" Content="Завершение"
                                         IsChecked="{Binding Mode, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static program:ProgramCompletionMode.Stop}}" />
                            <RadioButton GroupName="CompletionMode" Content="Начать с начала (по циклу)"
                                         IsChecked="{Binding Mode, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static program:ProgramCompletionMode.Loop}}" />
                            <RadioButton GroupName="CompletionMode" Content="В обратном порядке"
                                         IsChecked="{Binding Mode, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static program:ProgramCompletionMode.PingPong}}" />

                            <StackPanel Spacing="6" IsVisible="{Binding ShowRepeatCount}" Margin="0,4,0,0">
                                <TextBlock Text="Количество повторов" />
                                <TextBox Text="{Binding RepeatCount}" IsEnabled="{Binding !IsRepeatUnlimited}" />
                                <CheckBox Content="Неограниченно" IsChecked="{Binding IsRepeatUnlimited}" />
                            </StackPanel>

                            <CheckBox Content="Встать в начальную позицию по завершении" Margin="0,4,0,0"
                                      IsChecked="{Binding ReturnToStartOnFinish}" />

                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
                                <Button Command="{Binding CancelCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <materialIcons:MaterialIcon Kind="Close" Width="16" Height="16" VerticalAlignment="Center" />
                                        <TextBlock Text="Отмена" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="primary" Command="{Binding SaveCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <materialIcons:MaterialIcon Kind="ContentSave" Width="16" Height="16" VerticalAlignment="Center" />
                                        <TextBlock Text="Сохранить" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Border>

                <Border IsVisible="{Binding PendingRename, Converter={x:Static ObjectConverters.IsNotNull}}" Background="{StaticResource HudScrimBrush}">
                    <Border x:DataType="vm:RenameProgramRequest" DataContext="{Binding PendingRename}"
                            Width="320" Background="{StaticResource HudPanelElevatedBrush}"
                            BorderBrush="{StaticResource HudBorderStrongBrush}" BorderThickness="1"
                            Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Spacing="14">
                            <TextBlock Classes="section-heading" Text="ИМЯ ПРОГРАММЫ" />
                            <TextBox Text="{Binding Name}" PlaceholderText="Имя программы" />
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button Command="{Binding ((vm:ProgramViewModel)DataContext).CancelRenameCommand, ElementName=RootPanel}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <materialIcons:MaterialIcon Kind="Close" Width="16" Height="16" VerticalAlignment="Center" />
                                        <TextBlock Text="Отмена" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="primary" Command="{Binding ((vm:ProgramViewModel)DataContext).ConfirmRenameCommand, ElementName=RootPanel}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <materialIcons:MaterialIcon Kind="ContentSave" Width="16" Height="16" VerticalAlignment="Center" />
                                        <TextBlock Text="Сохранить" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Border>

                <Border IsVisible="{Binding PendingConfirmation, Converter={x:Static ObjectConverters.IsNotNull}}" Background="{StaticResource HudScrimBrush}">
                    <Border x:DataType="vm:ConfirmationRequest" DataContext="{Binding PendingConfirmation}"
                            Width="360" Background="{StaticResource HudPanelElevatedBrush}"
                            BorderBrush="{StaticResource HudBorderStrongBrush}" BorderThickness="1"
                            Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Spacing="14">
                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button Command="{Binding ((vm:ProgramViewModel)DataContext).ConfirmNoCommand, ElementName=RootPanel}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <materialIcons:MaterialIcon Kind="Close" Width="16" Height="16" VerticalAlignment="Center" />
                                        <TextBlock Text="Нет" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="primary" Command="{Binding ((vm:ProgramViewModel)DataContext).ConfirmYesCommand, ElementName=RootPanel}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <materialIcons:MaterialIcon Kind="Check" Width="16" Height="16" VerticalAlignment="Center" />
                                        <TextBlock Text="Да" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Border>

                <Border IsVisible="{Binding IsLibraryOpen}" Background="{StaticResource HudScrimBrush}">
                    <Border Width="420" MaxHeight="480" Background="{StaticResource HudPanelElevatedBrush}"
                            BorderBrush="{StaticResource HudBorderStrongBrush}" BorderThickness="1"
                            Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                                <TextBlock Grid.Column="0" Classes="section-heading" Text="БИБЛИОТЕКА" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Padding="8,2" Command="{Binding CloseLibraryCommand}">
                                    <materialIcons:MaterialIcon Kind="Close" Width="16" Height="16" />
                                </Button>
                            </Grid>
                            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,70,70" ColumnSpacing="10" Margin="8,0,8,4">
                                <TextBlock Grid.Column="0" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource HudTextSecondaryBrush}" Text="Название" />
                                <TextBlock Grid.Column="1" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource HudTextSecondaryBrush}" Text="Создано" />
                                <TextBlock Grid.Column="2" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource HudTextSecondaryBrush}" Text="Изменено" />
                            </Grid>
                            <Border DockPanel.Dock="Top" Height="1" Margin="8,0,8,4" Background="{StaticResource HudBorderStrongBrush}" />
                            <ListBox ItemsSource="{Binding Library}" SelectionChanged="OnLibrarySelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ProgramLibraryItem">
                                        <Border Classes.loaded-entry="{Binding IsLoaded}" Padding="8,4">
                                            <Grid ColumnDefinitions="*,70,70" ColumnSpacing="10">
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" FontSize="11" Foreground="{StaticResource HudTextSecondaryBrush}" VerticalAlignment="Center"
                                                           Text="{Binding CreatedAt, StringFormat='{}{0:dd.MM.yyyy}'}" />
                                                <TextBlock Grid.Column="2" FontSize="11" Foreground="{StaticResource HudTextSecondaryBrush}" VerticalAlignment="Center"
                                                           IsVisible="{Binding ShowModifiedAt}" Text="{Binding ModifiedAt, StringFormat='{}{0:dd.MM.yyyy}'}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </Border>

                <Border IsVisible="{Binding IsSideMenuOpen}" Background="{StaticResource HudScrimBrush}">
                    <Border Width="240" Background="{StaticResource HudPanelElevatedBrush}"
                            BorderBrush="{StaticResource HudBorderStrongBrush}" BorderThickness="0,0,1,0"
                            Padding="20" HorizontalAlignment="Left" VerticalAlignment="Stretch">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                                <TextBlock Grid.Column="0" Classes="section-heading" Text="МЕНЮ" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Padding="8,2" Command="{Binding CloseSideMenuCommand}">
                                    <materialIcons:MaterialIcon Kind="Close" Width="16" Height="16" />
                                </Button>
                            </Grid>
                            <StackPanel Spacing="8">
                                <Button Classes="header-action" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Command="{Binding OpenGCodeLogCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <materialIcons:MaterialIcon Kind="ScriptTextOutline" Width="16" Height="16" VerticalAlignment="Center" />
                                        <TextBlock Text="Лог G-code" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="header-action" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Command="{Binding OpenMockSettingsCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <materialIcons:MaterialIcon Kind="Flask" Width="16" Height="16" VerticalAlignment="Center" />
                                        <TextBlock Text="Настройки мока" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="header-action" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Command="{Binding OpenAboutCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <materialIcons:MaterialIcon Kind="InformationOutline" Width="16" Height="16" VerticalAlignment="Center" />
                                        <TextBlock Text="О программе" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="header-action" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Command="{Binding ExitCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <materialIcons:MaterialIcon Kind="ExitToApp" Width="16" Height="16" VerticalAlignment="Center" />
                                        <TextBlock Text="Выйти" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Border>

                <Border IsVisible="{Binding Connection.IsGCodeLogOpen}" Background="{x:Null}">
                    <Border MaxWidth="420" MaxHeight="480" Margin="16" Background="{StaticResource HudPanelElevatedBrush}"
                            BorderBrush="{StaticResource HudBorderStrongBrush}" BorderThickness="1"
                            Padding="20" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                                <TextBlock Grid.Column="0" Classes="section-heading" Text="ЛОГ G-CODE" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Padding="8,2" Command="{Binding Connection.ToggleGCodeLogCommand}">
                                    <materialIcons:MaterialIcon Kind="Close" Width="16" Height="16" />
                                </Button>
                            </Grid>
                            <ListBox x:Name="GCodeLogList" ItemsSource="{Binding Connection.SentGCodeLines}">
                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem">
                                        <Setter Property="FontFamily" Value="{StaticResource HudFontMono}" />
                                        <Setter Property="FontSize" Value="13" />
                                        <Setter Property="Padding" Value="0,2" />
                                    </Style>
                                </ListBox.Styles>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </Border>

                <Border IsVisible="{Binding Connection.IsMockSettingsOpen}" Background="{StaticResource HudScrimBrush}">
                    <Border Width="360" Background="{StaticResource HudPanelElevatedBrush}"
                            BorderBrush="{StaticResource HudBorderStrongBrush}" BorderThickness="1"
                            Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Spacing="14">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Classes="section-heading" Text="НАСТРОЙКИ МОКА" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Padding="8,2" Command="{Binding Connection.ToggleMockSettingsCommand}">
                                    <materialIcons:MaterialIcon Kind="Close" Width="16" Height="16" />
                                </Button>
                            </Grid>
                            <Button Command="{Binding Connection.TriggerMockErrorCommand}" HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <materialIcons:MaterialIcon Kind="AlertCircleOutline" Width="16" Height="16" VerticalAlignment="Center" />
                                    <TextBlock Text="Смоделировать ошибку" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding Connection.TriggerMockAlarmCommand}" HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <materialIcons:MaterialIcon Kind="AlertOctagon" Width="16" Height="16" VerticalAlignment="Center" />
                                    <TextBlock Text="Смоделировать аварию" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding Connection.MockResponseDelayMs, StringFormat='Задержка ответа: {0} мс'}" />
                                <Slider Minimum="0" Maximum="5000" TickFrequency="250" IsSnapToTickEnabled="True"
                                        Value="{Binding Connection.MockResponseDelayMs}" />
                            </StackPanel>
                            <StackPanel Spacing="8">
                                <TextBlock Text="Позиция устройства" />
                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                                        <TextBlock Text="X" />
                                        <NumericUpDown Value="{Binding Connection.MockPoseX}" FormatString="0.00" Increment="1" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2">
                                        <TextBlock Text="Y" />
                                        <NumericUpDown Value="{Binding Connection.MockPoseY}" FormatString="0.00" Increment="1" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2">
                                        <TextBlock Text="Z" />
                                        <NumericUpDown Value="{Binding Connection.MockPoseZ}" FormatString="0.00" Increment="1" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                                        <TextBlock Text="A" />
                                        <NumericUpDown Value="{Binding Connection.MockPoseA}" FormatString="0.00" Increment="1" />
                                    </StackPanel>
                                </Grid>
                                <Button Command="{Binding Connection.ApplyMockPoseCommand}" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <materialIcons:MaterialIcon Kind="CrosshairsGps" Width="16" Height="16" VerticalAlignment="Center" />
                                        <TextBlock Text="Установить позицию" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Border>

                <Border IsVisible="{Binding IsAboutOpen}" Background="{StaticResource HudScrimBrush}">
                    <Border MaxWidth="520" MaxHeight="640" Margin="16" Background="{StaticResource HudPanelElevatedBrush}"
                            BorderBrush="{StaticResource HudBorderStrongBrush}" BorderThickness="1"
                            Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                                <TextBlock Grid.Column="0" Classes="section-heading" Text="О ПРОГРАММЕ" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Padding="8,2" Command="{Binding CloseAboutCommand}">
                                    <materialIcons:MaterialIcon Kind="Close" Width="16" Height="16" />
                                </Button>
                            </Grid>

                            <Button DockPanel.Dock="Bottom" x:Name="CopyDiagnosticsButton" Classes="primary"
                                    HorizontalAlignment="Stretch" Margin="0,12,0,0"
                                    Click="OnCopyDiagnosticsClick">
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <materialIcons:MaterialIcon Kind="ContentCopy" Width="16" Height="16" VerticalAlignment="Center"
                                                               IsVisible="{Binding !About.IsCopied}" />
                                    <materialIcons:MaterialIcon Kind="Check" Width="16" Height="16" VerticalAlignment="Center"
                                                               IsVisible="{Binding About.IsCopied}" />
                                    <TextBlock Text="Скопировать всё" VerticalAlignment="Center"
                                               IsVisible="{Binding !About.IsCopied}" />
                                    <TextBlock Text="Скопировано" VerticalAlignment="Center"
                                               IsVisible="{Binding About.IsCopied}" />
                                </StackPanel>
                            </Button>

                            <!-- Horizontal scrolling stays off deliberately: it would hand the
                                 lines an unbounded width, which stops TextWrapping from ever
                                 applying and clips long values (OS version, firmware banner). -->
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding About.Sections}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="diagnostics:DiagnosticsSection">
                                            <StackPanel Spacing="2" Margin="0,0,0,14">
                                                <TextBlock Classes="section-heading" Text="{Binding Title}" Margin="0,0,0,4" />
                                                <ItemsControl ItemsSource="{Binding DisplayLines}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="sys:String">
                                                            <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                                                       FontFamily="{StaticResource HudFontMono}" FontSize="12" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Border>
            </Grid>
        </DockPanel>

        <Border IsVisible="{Binding Connection.IsAutoConnectSplashVisible}" Background="{StaticResource HudScrimBrush}">
            <StackPanel x:DataType="vm:ConnectionViewModel" DataContext="{Binding Connection}"
                        Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center" Width="280">
                <ProgressBar IsIndeterminate="True" HorizontalAlignment="Stretch" />
                <TextBlock Text="{Binding AutoConnectStatusText}" HorizontalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center" />
            </StackPanel>
        </Border>

        <Border IsVisible="{Binding Connection.IsConnectionModalVisible}" Background="{StaticResource HudScrimBrush}">
            <Border x:DataType="vm:ConnectionViewModel" DataContext="{Binding Connection}"
                    Width="360" Background="{StaticResource HudPanelElevatedBrush}"
                    BorderBrush="{StaticResource HudBorderStrongBrush}" BorderThickness="1"
                    Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <TextBlock Classes="section-heading" Text="ПОДКЛЮЧЕНИЕ" />
                    <Border IsVisible="{Binding IsRealDeviceUnsupported}"
                            Background="{StaticResource HudWarningDimBrush}"
                            BorderBrush="{StaticResource HudWarningBrush}" BorderThickness="1" Padding="10,6">
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource HudWarningBrush}"
                                   Text="Web Serial API не поддерживается этим браузером. Доступен только режим «Демо»." />
                    </Border>
                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                     Fill="{Binding ConnectionState, Converter={StaticResource StateToBrush}}" />
                            <TextBlock VerticalAlignment="Center"
                                       Text="{Binding ConnectionStateLabel}" />
                        </StackPanel>
                        <Button Grid.Column="1" IsVisible="{Binding IsDiscoverySupported}" Command="{Binding ScanCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <materialIcons:MaterialIcon Kind="BluetoothSearching" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Text="Поиск" IsVisible="{Binding !IsScanning}" VerticalAlignment="Center" />
                                <TextBlock Text="Стоп" IsVisible="{Binding IsScanning}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <ListBox ItemsSource="{Binding AvailableEndpoints}"
                             SelectedItem="{Binding SelectedEndpoint}"
                             MaxHeight="180">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ConnectionEndpoint">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock Grid.Column="0" Text="{Binding DisplayName}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding StatusLabel}" VerticalAlignment="Center"
                                               FontSize="12" Foreground="{StaticResource HudTextSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border IsVisible="{Binding HasEndpointError}"
                            Background="{StaticResource HudWarningDimBrush}"
                            BorderBrush="{StaticResource HudWarningBrush}" BorderThickness="1" Padding="10,6">
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource HudWarningBrush}"
                                   Text="{Binding EndpointError}" />
                    </Border>
                    <Button Classes="primary" Command="{Binding ConnectCommand}" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <materialIcons:MaterialIcon Kind="Bluetooth" Width="16" Height="16" VerticalAlignment="Center" />
                            <TextBlock Text="Подключить" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Border>

        <Border IsVisible="{Binding Connection.IsAlarmModalVisible}" Background="{StaticResource HudScrimBrush}">
            <Border x:DataType="vm:ConnectionViewModel" DataContext="{Binding Connection}"
                    Width="360" Background="{StaticResource HudPanelElevatedBrush}"
                    BorderBrush="{StaticResource HudBorderStrongBrush}" BorderThickness="1"
                    Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <TextBlock Classes="section-heading" Text="АВАРИЯ" />
                    <TextBlock TextWrapping="Wrap" Text="{Binding ErrorMessage}" />
                    <Button Classes="danger" Command="{Binding ResetAlarmCommand}" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <materialIcons:MaterialIcon Kind="Restore" Width="16" Height="16" VerticalAlignment="Center" />
                            <TextBlock Text="Сброс аварии" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Border>

        <!-- Последним в Grid: перекрывает и остальные модалки, включая аварийную. -->
        <Border IsVisible="{Binding IsShuttingDown}" Background="{StaticResource HudScrimBrush}">
            <StackPanel Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center" Width="280">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <materialIcons:MaterialIcon Kind="StopCircleOutline" Width="18" Height="18" VerticalAlignment="Center" />
                    <TextBlock Text="Остановка устройства…" VerticalAlignment="Center" />
                </StackPanel>
                <ProgressBar IsIndeterminate="True" HorizontalAlignment="Stretch" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
