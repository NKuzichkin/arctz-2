<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:ArctZ.ViewModels"
             xmlns:js="using:ArctZ.Components.VirtualJoystick"
             xmlns:program="using:ArctZ.Services.Program"
             xmlns:conv="using:ArctZ.Converters"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="ArctZ.Views.MainView"
             x:DataType="vm:ProgramViewModel"
             Background="{StaticResource HudBackgroundBrush}"
             Foreground="{StaticResource HudTextPrimaryBrush}">

    <UserControl.Resources>
        <conv:ConnectionStateToBrushConverter x:Key="StateToBrush" />
        <conv:LabelLengthToFontSizeConverter x:Key="LabelLengthToFontSize" />
        <js:RadiusToSizeConverter x:Key="RadiusToSize" />
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Border.reveal-1, Border.reveal-2, Border.reveal-3">
            <Style.Animations>
                <Animation Duration="0:0:0.4" Easing="CubicEaseOut" FillMode="Forward">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Border.reveal-2">
            <Style.Animations>
                <Animation Duration="0:0:0.4" Delay="0:0:0.08" Easing="CubicEaseOut" FillMode="Forward">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Border.reveal-3">
            <Style.Animations>
                <Animation Duration="0:0:0.4" Delay="0:0:0.16" Easing="CubicEaseOut" FillMode="Forward">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Foreground/Background/BorderBrush below use DynamicResource, not StaticResource,
             for consistency with ArctZ/Themes/HudControls.axaml and VirtualJoystick.axaml's
             Hud*-referencing Setters, and as a hardening measure: Setter values in ANY
             Styles collection resolve once when that collection is populated, so a
             StaticResource Setter here is only safe as long as MainView keeps being built
             after App.axaml.cs applies the print-theme palette (true today, since MainView
             is only ever constructed from OnFrameworkInitializationCompleted). Direct
             element attributes elsewhere in this file (e.g. this UserControl's own
             Background/Foreground above) resolve correctly with StaticResource for the
             same reason, and don't need to change. -->
        <Style Selector="TextBlock.section-heading">
            <Setter Property="FontFamily" Value="{StaticResource HudFontBody}" />
            <Setter Property="FontSize" Value="{StaticResource HudFontSizeSmall}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{DynamicResource HudTextSecondaryBrush}" />
            <Setter Property="LetterSpacing" Value="1.5" />
        </Style>

        <Style Selector="Border.loaded-entry">
            <Setter Property="Background" Value="{DynamicResource HudAccentDimBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HudAccentBrush}" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
        </Style>

    </UserControl.Styles>

    <Grid>
        <DockPanel IsEnabled="{Binding !Connection.IsAnyModalVisible}">
            <Border x:Name="HeaderBorder" DockPanel.Dock="Top" Classes="reveal-1"
                    Background="{StaticResource HudPanelBrush}"
                    BorderBrush="{StaticResource HudBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="12,10">
                <StackPanel x:Name="HeaderPanel" Spacing="8">
                    <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                        <Button Grid.Column="0" Classes="icon-action" Content="☰" Command="{Binding ToggleSideMenuCommand}" Margin="0,0,8,0" />
                        <Border x:Name="HeaderStatusRow" Grid.Column="1" Background="{StaticResource HudPanelElevatedBrush}" BorderBrush="{StaticResource HudBorderStrongBrush}"
                                BorderThickness="1" Padding="10,6">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" VerticalAlignment="Center">
                                <ContentControl x:Name="ConnectionStatus" Grid.Column="0" ClipToBounds="True" Content="{Binding Connection}" />
                                <Border Grid.Column="1" Classes="header-divider" />
                                <TextBlock Grid.Column="2" Classes="telemetry" FontSize="14" VerticalAlignment="Center" Text="{Binding StatusLabel}" />
                                <Border Grid.Column="3" Classes="header-divider" />
                                <Button Grid.Column="4" Classes="icon-action" Command="{Binding Connection.DisconnectCommand}" ToolTip.Tip="Отключить">
                                    <Path Width="18" Height="18" Stretch="Uniform"
                                          Stroke="{DynamicResource HudTextPrimaryBrush}" StrokeThickness="2"
                                          StrokeLineCap="Round" StrokeJoin="Round"
                                          Data="M18.36,6.64 A9,9 0 1 1 5.64,6.64 M12,2 L12,12" />
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                    <ScrollViewer x:Name="HeaderActionsScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  IsEnabled="{Binding !IsSideMenuOpen}">
                        <StackPanel x:Name="HeaderActions" Orientation="Horizontal" Spacing="8">
                            <Button Classes="primary header-action" Content="Пуск" Command="{Binding PlayCommand}" />
                            <Button Classes="header-action" Content="Пауза" Command="{Binding PauseCommand}" />
                            <Button Classes="danger header-action" Content="Стоп" Command="{Binding StopCommand}" />
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- A single Grid is the DockPanel's true last child so it receives the fill slot;
                 the program panel and its overlays sit stacked inside it, toggled by IsVisible. -->
            <Grid x:Name="RootPanel">
                <!-- radius formula in MainView.axaml.cs (ComputeJoystickRadius) depends on these margins —
                     see ContentGridChromeWidth/ContentBorderVerticalChrome/ContentGridVerticalMargin/JoystickBarTopMargin -->
                <Border Classes="reveal-3" Margin="12"
                        Background="{StaticResource HudPanelBrush}"
                        BorderBrush="{StaticResource HudBorderBrush}"
                        BorderThickness="1">
                    <Grid x:Name="ContentGrid" RowDefinitions="*,Auto" Margin="20">
                        <ScrollViewer x:Name="ProgramPanel" Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="10">
                            <StackPanel Spacing="10" IsEnabled="{Binding !IsProgramLocked}">
                                <TextBlock Classes="section-heading" Text="ПРОГРАММА" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Classes="telemetry" FontSize="16" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Text="{Binding ProgramName}" />
                                    <Button Grid.Column="1" Content="⋮" Padding="8,2" VerticalAlignment="Center">
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuItem Header="Переименовать" Command="{Binding RenameProgramCommand}" />
                                                <MenuItem Header="Новая" Command="{Binding NewProgramCommand}" />
                                                <MenuItem Header="Сохранить" Command="{Binding SaveProgramCommand}" />
                                                <MenuItem Header="Библиотека" Command="{Binding OpenLibraryCommand}" />
                                                <Separator />
                                                <MenuItem Header="Захватить" Command="{Binding CaptureKeyPointCommand}" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </Grid>
                                <TextBlock Classes="section-heading" Text="ТОЧКИ" Margin="0,8,0,0" />
                                <ItemsControl x:Name="KeyPointsList" ItemsSource="{Binding KeyPoints}"
                                              ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel ItemSpacing="8" LineSpacing="8" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="program:KeyPoint">
                                            <Button Width="120" Height="60"
                                                    Background="{StaticResource HudPanelElevatedBrush}"
                                                    BorderBrush="{StaticResource HudBorderBrush}" BorderThickness="1"
                                                    Padding="16,14" HorizontalContentAlignment="Left">
                                                <Button.Flyout>
                                                    <MenuFlyout>
                                                        <MenuItem Header="На точку" CommandParameter="{Binding}"
                                                                  Command="{Binding ((vm:ProgramViewModel)DataContext).MoveMachineToKeyPointCommand, ElementName=KeyPointsList}" />
                                                        <MenuItem Header="Изменить" CommandParameter="{Binding}"
                                                                  Command="{Binding ((vm:ProgramViewModel)DataContext).EditKeyPointCommand, ElementName=KeyPointsList}" />
                                                        <MenuItem Header="Из машины" CommandParameter="{Binding}"
                                                                  Command="{Binding ((vm:ProgramViewModel)DataContext).FillKeyPointFromCurrentPositionCommand, ElementName=KeyPointsList}" />
                                                        <MenuItem Header="Переместить вверх" CommandParameter="{Binding}"
                                                                  Command="{Binding ((vm:ProgramViewModel)DataContext).MoveKeyPointUpCommand, ElementName=KeyPointsList}" />
                                                        <MenuItem Header="Переместить вниз" CommandParameter="{Binding}"
                                                                  Command="{Binding ((vm:ProgramViewModel)DataContext).MoveKeyPointDownCommand, ElementName=KeyPointsList}" />
                                                        <MenuItem Header="Удалить" CommandParameter="{Binding}"
                                                                  Command="{Binding ((vm:ProgramViewModel)DataContext).RemoveKeyPointCommand, ElementName=KeyPointsList}" />
                                                    </MenuFlyout>
                                                </Button.Flyout>
                                                <TextBlock Classes="telemetry" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                                           FontSize="{Binding Label, Converter={StaticResource LabelLengthToFontSize}}"
                                                           Text="{Binding Label}" />
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" Margin="0,12,0,0"
                                  IsVisible="{Binding IsProgramLocked}">
                                <TextBlock Grid.Row="0" Grid.Column="0" Classes="section-heading" Text="СЕГМЕНТ" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Classes="telemetry" FontSize="16" Text="{Binding SegmentProgressLabel}" />
                                <ProgressBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,0"
                                             Minimum="0" Maximum="1" Value="{Binding SegmentProgress}" />
                            </Grid>

                            <Border IsVisible="{Binding FaultedAtSegmentIndex, Converter={x:Static ObjectConverters.IsNotNull}}"
                                    Background="{StaticResource HudWarningDimBrush}" BorderBrush="{StaticResource HudWarningBrush}"
                                    BorderThickness="1" Padding="12,8" Margin="0,12,0,0">
                                <TextBlock Foreground="{StaticResource HudWarningBrush}" TextWrapping="Wrap"
                                           Text="{Binding FaultedMessage}" />
                            </Border>
                        </StackPanel>
                        </ScrollViewer>

                        <Grid x:Name="JoystickBar" Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,12,0,0">
                            <StackPanel Grid.Column="0" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <js:VirtualJoystick x:Name="LeftJoystick" Mode="Fixed" Shape="Circle"
                                                     IsEnabled="{Binding !IsProgramLocked}"
                                                     JoystickDown="OnLeftJoystickDown" JoystickMove="OnLeftJoystickMove" JoystickUp="OnLeftJoystickUp" />
                                <TextBlock Text="Подъём / поворот стрелы" Opacity="0.6" FontSize="12"
                                           TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"
                                           MaxWidth="{Binding Radius, ElementName=LeftJoystick, Converter={StaticResource RadiusToSize}}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <js:VirtualJoystick x:Name="RightJoystick" Mode="Fixed" Shape="Circle"
                                                     IsEnabled="{Binding !IsProgramLocked}"
                                                     JoystickDown="OnRightJoystickDown" JoystickMove="OnRightJoystickMove" JoystickUp="OnRightJoystickUp" />
                                <TextBlock Text="Пан / наклон камеры" Opacity="0.6" FontSize="12"
                                           TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"
                                           MaxWidth="{Binding Radius, ElementName=RightJoystick, Converter={StaticResource RadiusToSize}}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <Border IsVisible="{Binding IsEditingKeyPoint}" Background="{StaticResource HudScrimBrush}">
                    <Border x:DataType="vm:KeyPointEditorViewModel" DataContext="{Binding KeyPointEditor}"
                            Width="320" Background="{StaticResource HudPanelElevatedBrush}"
                            BorderBrush="{StaticResource HudBorderStrongBrush}" BorderThickness="1"
                            Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Spacing="10">
                            <TextBlock Classes="section-heading" Text="{Binding Number, StringFormat='ТОЧКА №{0}'}" />
                            <TextBox Text="{Binding Label}" PlaceholderText="Название" MaxLength="30" />
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="0,4,0,0">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="X" VerticalAlignment="Center" Margin="0,0,10,6" />
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding X}" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Y" VerticalAlignment="Center" Margin="0,0,10,6" />
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Y}" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Z" VerticalAlignment="Center" Margin="0,0,10,6" />
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Z}" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="A" VerticalAlignment="Center" Margin="0,0,10,6" />
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding A}" Margin="0,0,0,6" />
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Стоянка, с" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding DwellSeconds}" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
                                <Button Content="Отмена" Command="{Binding CancelCommand}" />
                                <Button Classes="primary" Content="Сохранить" Command="{Binding SaveCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Border>

                <Border IsVisible="{Binding PendingRename, Converter={x:Static ObjectConverters.IsNotNull}}" Background="{StaticResource HudScrimBrush}">
                    <Border x:DataType="vm:RenameProgramRequest" DataContext="{Binding PendingRename}"
                            Width="320" Background="{StaticResource HudPanelElevatedBrush}"
                            BorderBrush="{StaticResource HudBorderStrongBrush}" BorderThickness="1"
                            Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Spacing="14">
                            <TextBlock Classes="section-heading" Text="ИМЯ ПРОГРАММЫ" />
                            <TextBox Text="{Binding Name}" PlaceholderText="Имя программы" />
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button Content="Отмена" Command="{Binding ((vm:ProgramViewModel)DataContext).CancelRenameCommand, ElementName=RootPanel}" />
                                <Button Classes="primary" Content="Сохранить" Command="{Binding ((vm:ProgramViewModel)DataContext).ConfirmRenameCommand, ElementName=RootPanel}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Border>

                <Border IsVisible="{Binding PendingConfirmation, Converter={x:Static ObjectConverters.IsNotNull}}" Background="{StaticResource HudScrimBrush}">
                    <Border x:DataType="vm:ConfirmationRequest" DataContext="{Binding PendingConfirmation}"
                            Width="360" Background="{StaticResource HudPanelElevatedBrush}"
                            BorderBrush="{StaticResource HudBorderStrongBrush}" BorderThickness="1"
                            Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Spacing="14">
                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button Content="Нет" Command="{Binding ((vm:ProgramViewModel)DataContext).ConfirmNoCommand, ElementName=RootPanel}" />
                                <Button Classes="primary" Content="Да" Command="{Binding ((vm:ProgramViewModel)DataContext).ConfirmYesCommand, ElementName=RootPanel}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Border>

                <Border IsVisible="{Binding IsLibraryOpen}" Background="{StaticResource HudScrimBrush}">
                    <Border Width="320" MaxHeight="480" Background="{StaticResource HudPanelElevatedBrush}"
                            BorderBrush="{StaticResource HudBorderStrongBrush}" BorderThickness="1"
                            Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                                <TextBlock Grid.Column="0" Classes="section-heading" Text="БИБЛИОТЕКА" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="✕" Padding="8,2" Command="{Binding CloseLibraryCommand}" />
                            </Grid>
                            <ListBox ItemsSource="{Binding Library}" SelectionChanged="OnLibrarySelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ProgramLibraryItem">
                                        <Border Classes.loaded-entry="{Binding IsLoaded}" Padding="8,4">
                                            <TextBlock Text="{Binding Name}" />
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </Border>

                <Border IsVisible="{Binding IsSideMenuOpen}" Background="{StaticResource HudScrimBrush}">
                    <Border Width="240" Background="{StaticResource HudPanelElevatedBrush}"
                            BorderBrush="{StaticResource HudBorderStrongBrush}" BorderThickness="0,0,1,0"
                            Padding="20" HorizontalAlignment="Left" VerticalAlignment="Stretch">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                                <TextBlock Grid.Column="0" Classes="section-heading" Text="МЕНЮ" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="✕" Padding="8,2" Command="{Binding CloseSideMenuCommand}" />
                            </Grid>
                            <StackPanel Spacing="8">
                                <Button Classes="header-action" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                        Content="Лог G-code" Command="{Binding OpenGCodeLogCommand}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Border>

                <Border IsVisible="{Binding Connection.IsGCodeLogOpen}" Background="{x:Null}" IsHitTestVisible="False">
                    <Border MaxWidth="420" MaxHeight="480" Margin="16" Background="{StaticResource HudPanelElevatedBrush}"
                            BorderBrush="{StaticResource HudBorderStrongBrush}" BorderThickness="1"
                            Padding="20" HorizontalAlignment="Right" VerticalAlignment="Top"
                            IsHitTestVisible="True">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                                <TextBlock Grid.Column="0" Classes="section-heading" Text="ЛОГ G-CODE" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="✕" Padding="8,2" Command="{Binding Connection.ToggleGCodeLogCommand}" />
                            </Grid>
                            <ListBox x:Name="GCodeLogList" ItemsSource="{Binding Connection.SentGCodeLines}">
                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem">
                                        <Setter Property="FontFamily" Value="{StaticResource HudFontMono}" />
                                        <Setter Property="FontSize" Value="13" />
                                        <Setter Property="Padding" Value="0,2" />
                                    </Style>
                                </ListBox.Styles>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </Border>
            </Grid>
        </DockPanel>

        <Border IsVisible="{Binding Connection.IsConnectionModalVisible}" Background="{StaticResource HudScrimBrush}">
            <Border x:DataType="vm:ConnectionViewModel" DataContext="{Binding Connection}"
                    Width="360" Background="{StaticResource HudPanelElevatedBrush}"
                    BorderBrush="{StaticResource HudBorderStrongBrush}" BorderThickness="1"
                    Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <TextBlock Classes="section-heading" Text="ПОДКЛЮЧЕНИЕ" />
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                 Fill="{Binding ConnectionState, Converter={StaticResource StateToBrush}}" />
                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding ConnectionStateLabel}" />
                    </StackPanel>
                    <ComboBox ItemsSource="{Binding AvailableEndpoints}"
                              SelectedItem="{Binding SelectedEndpoint}"
                              DisplayMemberBinding="{Binding DisplayName}"
                              HorizontalAlignment="Stretch" />
                    <Button Classes="primary" Content="Подключить" Command="{Binding ConnectCommand}"
                            HorizontalAlignment="Stretch" />
                </StackPanel>
            </Border>
        </Border>

        <Border IsVisible="{Binding Connection.IsAlarmModalVisible}" Background="{StaticResource HudScrimBrush}">
            <Border x:DataType="vm:ConnectionViewModel" DataContext="{Binding Connection}"
                    Width="360" Background="{StaticResource HudPanelElevatedBrush}"
                    BorderBrush="{StaticResource HudBorderStrongBrush}" BorderThickness="1"
                    Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <TextBlock Classes="section-heading" Text="АВАРИЯ" />
                    <TextBlock TextWrapping="Wrap" Text="{Binding ErrorMessage}" />
                    <Button Classes="danger" Content="Сброс аварии" Command="{Binding ResetAlarmCommand}"
                            HorizontalAlignment="Stretch" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
