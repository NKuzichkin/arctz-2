<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Sharper, more instrument-panel edges than Fluent's default rounded corners,
       and roomier touch targets since this runs touch and desktop side by side. -->
  <Style>
    <Style.Resources>
      <CornerRadius x:Key="ControlCornerRadius">2</CornerRadius>
      <CornerRadius x:Key="OverlayCornerRadius">2</CornerRadius>
      <Thickness x:Key="ButtonPadding">16,10</Thickness>
      <x:Double x:Key="TextControlThemeMinHeight">40</x:Double>
      <Thickness x:Key="TextControlThemePadding">12,8,8,8</Thickness>
    </Style.Resources>
  </Style>

  <Style Selector="Button, ToggleButton, ComboBox, ComboBoxItem, ListBoxItem, TextBox, TextBlock">
    <Setter Property="TextElement.FontFamily" Value="{StaticResource HudFontBody}" />
    <Setter Property="TextElement.FontSize" Value="{StaticResource HudFontSizeBody}" />
  </Style>

  <Style Selector="Button, ToggleButton, ComboBox, TextBox">
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!-- ComboBox has no ButtonPadding-equivalent resource key of its own, so without an
       explicit Padding/MinHeight it falls back to Fluent's shorter stock vertical padding
       and sits noticeably shorter than Button/ToggleButton/TextBox in the same toolbar row. -->
  <Style Selector="ComboBox">
    <Setter Property="Padding" Value="12,8,8,8" />
    <Setter Property="MinHeight" Value="40" />
  </Style>

  <!-- Primary action (Play, Захватить точку, ...): the one button per panel that should
       read as "the thing to press", picked out with the accent instead of flat graphite.

       The Hud*Brush/Hud*Color Setter values from here down use DynamicResource, not
       StaticResource: this file's Styles are loaded once via AvaloniaXamlLoader.Load,
       before App.axaml.cs conditionally merges the print-theme palette (the theme=print
       flag). A StaticResource Setter would permanently bake in the dark HUD color
       regardless of that flag. -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource HudAccentDimBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HudAccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource HudAccentBrightBrush}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HudAccentBrush}" />
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource HudBackgroundBrush}" />
  </Style>

  <!-- Destructive / stop actions get the warning tone, never the accent. -->
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{DynamicResource HudWarningDimBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HudWarningBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource HudWarningBrush}" />
  </Style>

  <!-- List panels read as instrument sub-panels: flat fill, no per-row card shadow,
       a left accent bar marks the selected row instead of a full highlight fill. -->
  <Style Selector="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBoxItem">
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="BorderBrush" Value="{DynamicResource HudBorderBrush}" />
  </Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource HudAccentBrush}" />
    <Setter Property="BorderThickness" Value="3,0,0,0" />
  </Style>

  <!-- ComboBox dropdown rows: FluentTheme's default is a solid accent-filled pill with
       dark text on :selected, which reads as a completely different control language from
       the rest of the HUD. Bring it in line with ListBoxItem's flat panel + left accent bar. -->
  <Style Selector="ComboBoxItem">
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource HudTextPrimaryBrush}" />
  </Style>
  <Style Selector="ComboBoxItem:pointerover">
    <Setter Property="Background" Value="{DynamicResource HudPanelElevatedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource HudTextPrimaryBrush}" />
  </Style>
  <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HudAccentDimBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource HudAccentBrightBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HudAccentBrush}" />
    <Setter Property="BorderThickness" Value="3,0,0,0" />
  </Style>

  <!-- Telemetry readouts (waypoint pose, segment index) render in mono for that
       instrument-cluster feel; applied per-view via the HudTelemetry class since not
       every TextBlock in the app is a numeric readout. -->
  <Style Selector="TextBlock.telemetry">
    <Setter Property="FontFamily" Value="{StaticResource HudFontMono}" />
    <Setter Property="FontSize" Value="{StaticResource HudFontSizeTelemetry}" />
    <Setter Property="Foreground" Value="{DynamicResource HudAccentBrush}" />
  </Style>

  <Style Selector="ProgressBar">
    <Setter Property="Background" Value="{DynamicResource HudPanelElevatedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource HudAccentBrush}" />
    <Setter Property="MinHeight" Value="6" />
    <Setter Property="CornerRadius" Value="3" />
  </Style>

  <!-- Print theme (Window.print, set by App when launched with theme=print):
       every button gets a plain white fill with a black border/text, matching
       the rest of the controls. Button.primary and Button.danger's own rules
       above fill with HudAccentDimBrush/HudWarningDimBrush, which the print
       palette maps to light grey, not white, so both need an explicit
       white-background override here. Primary still reads as "the button to
       press" via its FontWeight="Medium" alone; danger is told apart from
       primary by a heavier border instead of a color. Primary's :pointerover
       state (still HudAccentBrush = black fill in print) is also neutralized
       here, so a screenshot taken mid-hover doesn't show a solid black button. -->
  <Style Selector="Window.print Button.primary">
    <Setter Property="Background" Value="{DynamicResource HudBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HudBorderStrongBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource HudTextPrimaryBrush}" />
  </Style>
  <Style Selector="Window.print Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HudPanelElevatedBrush}" />
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource HudTextPrimaryBrush}" />
  </Style>
  <Style Selector="Window.print Button.danger">
    <Setter Property="Background" Value="{DynamicResource HudBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource HudBorderStrongBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource HudTextPrimaryBrush}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <!-- Header action row (Пуск/Пауза/Стоп): runs inside a horizontally swiping
       ScrollViewer on phones, so it needs a touch target bigger than the shared ButtonPadding
       gives buttons elsewhere in the app. (Homing was removed; Сброс аварии now lives in the
       alarm modal, Отключить in the status panel's icon-action button, and Лог G-code in the
       side menu — see below. Button.header-action is reused as-is for the side menu's item
       buttons, for the same touch-target reasoning.) -->
  <Style Selector="Button.header-action">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Padding" Value="18,12" />
  </Style>

  <!-- Hairline separator between command groups (connection vs. playback) in the header action row. -->
  <Style Selector="Border.header-divider">
    <Setter Property="Width" Value="1" />
    <Setter Property="Margin" Value="4,4" />
    <Setter Property="Background" Value="{DynamicResource HudBorderBrush}" />
  </Style>

  <!-- Icon-only header action (disconnect ⏻): lives in the unified status panel instead of the
       swiping action row, so it needs the same 44px minimum touch target as Button.header-action
       even though its content is a single glyph, not a text label. -->
  <Style Selector="Button.icon-action">
    <Setter Property="MinWidth" Value="44" />
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Padding" Value="10" />
    <Setter Property="FontSize" Value="18" />
  </Style>

</Styles>
